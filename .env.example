# Sao chép thành .env (đã .gitignore). Chỉ chứa giá trị mẫu cho máy cục bộ — KHÔNG điền khoá thật vào file này.

# ---- CSDL cục bộ (infra/docker-compose.yml) ----
POSTGRES_USER=smarttask
POSTGRES_PASSWORD=smarttask
POSTGRES_DB=smarttask
POSTGRES_PORT=5434   # 5432 = Postgres cục bộ, 5433 = Table_Calendar; SmartTask dùng 5434

# Prisma (Tuần 07). Cục bộ: cùng một URL. Supabase: DATABASE_URL qua pooler (port 6543, pgbouncer=true),
# DIRECT_URL cổng 5432 dùng cho migrate.
DATABASE_URL=postgresql://smarttask:smarttask@localhost:5434/smarttask?schema=public
DIRECT_URL=postgresql://smarttask:smarttask@localhost:5434/smarttask?schema=public

# ---- API (Tuần 07) ----
PORT=3000
CORS_ORIGIN=http://localhost:3001
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-32-ky-tu
JWT_REFRESH_SECRET=doi-thanh-chuoi-ngau-nhien-khac
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
APP_KEY=khoa-ma-hoa-aes-32-byte-base64        # mã hoá khoá API AI lưu trong CSDL

# ---- Tìm kiếm @mention (tuỳ chọn) ----
# Có URL → Elasticsearch (make search-up); bỏ trống → pg_trgm trong Postgres
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# ---- Storage (Tuần 08) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# ---- AI (Tuần 08) ----
AI_PROVIDER=gemini                            # gemini | ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_DAILY_LIMIT_PER_USER=20

# ---- Web Push (Tuần 08, Should) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nhom@example.com

# ---- Web (Tuần 08) ----
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
