{
  "name": "smarttask",
  "private": true,
  "version": "0.1.0",
  "description": "SmartTask — Smart Task & Workload Management Platform with AI Agent (Đồ án chuyên ngành 841476)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "api:start": "npm run start:prod -w apps/api",
    "api:test": "npm test -w apps/api",
    "api:test:e2e": "npm run test:e2e -w apps/api",
    "api:lint": "npm run lint -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "db:studio": "npm run prisma:studio -w apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "shared:build": "npm run build -w @smarttask/shared",
    "prepare": "npm run shared:build"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
